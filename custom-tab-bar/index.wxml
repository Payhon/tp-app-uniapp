<view class="ctb">
  <view class="ctb__bar">
    <view class="ctb__item" data-index="0" data-url="/pages/home/home" bindtap="onSwitchTab">
      <image class="ctb__icon" src="{{selected === 0 ? '/static/image/navbar-home-on@2x.png' : '/static/image/navbar-home@2x.png'}}" mode="aspectFit" />
      <text class="ctb__text {{selected === 0 ? 'ctb__text--active' : ''}}">{{textHome}}</text>
    </view>

    <view class="ctb__item ctb__item--mid" bindtap="onAdd">
      <image class="ctb__icon ctb__icon--mid" src="/static/image/navbar-add@2x.png" mode="aspectFit" />
      <text class="ctb__text">{{textAddDevice}}</text>
    </view>

    <view class="ctb__item" data-index="1" data-url="/pages/my/my" bindtap="onSwitchTab">
      <view class="ctb__icon-wrap">
        <image class="ctb__icon" src="{{selected === 1 ? '/static/image/navbar-me-on@2x.png' : '/static/image/navbar-me@2x.png'}}" mode="aspectFit" />
        <view wx:if="{{warrantyReminderNeeded}}" class="ctb__dot"></view>
      </view>
      <text class="ctb__text {{selected === 1 ? 'ctb__text--active' : ''}}">{{textMe}}</text>
    </view>
  </view>
  <view class="ctb__safe"></view>
  <view wx:if="{{actionSheetVisible}}" class="ctb-sheet" bindtap="closeActionSheet">
    <view class="ctb-sheet__panel" catchtap="noop">
      <view
        wx:for="{{actionSheetItems}}"
        wx:key="index"
        class="ctb-sheet__item"
        data-index="{{index}}"
        bindtap="onActionSheetItem"
      >{{item}}</view>
      <view class="ctb-sheet__gap"></view>
      <view class="ctb-sheet__cancel" bindtap="closeActionSheet">{{textCancel}}</view>
    </view>
  </view>
</view>
