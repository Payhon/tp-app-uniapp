.ctb {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

.ctb__bar {
  position: relative;
  height: 120rpx;
  background: #ffffff;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  box-shadow: 0 -6rpx 30rpx rgba(0, 0, 0, 0.08);
  padding: 0 40rpx 18rpx;
  box-sizing: border-box;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  overflow: visible;
}

/* 中间突出：仅“上半椭圆”，下半与 TabBar 融为一体（无阴影） */
.ctb__bar::before {
  content: '';
  position: absolute;
  left: 50%;
  top: -54rpx;
  transform: translateX(-50%);
  width: 240rpx;
  height: 108rpx;
  background: #ffffff;
  border-radius: 999px 999px 0 0;
  z-index: 1;
}

.ctb__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  z-index: 2;
}

.ctb__icon {
  width: 44rpx;
  height: 44rpx;
}

.ctb__text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #908f92;
}

.ctb__text--active {
  color: #2f6bff;
}

.ctb__item--mid {
  padding-bottom: 2rpx;
}

.ctb__icon--mid {
  width: 68rpx;
  height: 68rpx;
  margin-bottom: 6rpx;
  margin-top: -42rpx;
}

.ctb__safe {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
  background: #ffffff;
}
