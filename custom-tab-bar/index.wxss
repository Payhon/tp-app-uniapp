.ctb {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

.ctb__bar {
  position: relative;
  height: 120rpx;
  background: #ffffff;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  box-shadow: 0 -6rpx 30rpx rgba(0, 0, 0, 0.08);
  padding: 0 40rpx 18rpx;
  box-sizing: border-box;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  overflow: visible;
}

/* 中间突出：仅“上半椭圆”，下半与 TabBar 融为一体（无阴影） */
.ctb__bar::before {
  content: '';
  position: absolute;
  left: 50%;
  top: -54rpx;
  transform: translateX(-50%);
  width: 240rpx;
  height: 108rpx;
  background: #ffffff;
  border-radius: 999px 999px 0 0;
  z-index: 1;
}

.ctb__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  z-index: 2;
}

.ctb__icon {
  width: 44rpx;
  height: 44rpx;
}

.ctb__icon-wrap {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.ctb__dot {
  position: absolute;
  top: -4rpx;
  right: -8rpx;
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  background: #f04438;
  box-sizing: border-box;
}

.ctb__text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #908f92;
}

.ctb__text--active {
  color: #2f6bff;
}

.ctb__item--mid {
  padding-bottom: 2rpx;
}

.ctb__icon--mid {
  width: 68rpx;
  height: 68rpx;
  margin-bottom: 6rpx;
  margin-top: -42rpx;
}

.ctb__safe {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
  background: #ffffff;
}

.ctb-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  box-sizing: border-box;
}

.ctb-sheet__panel {
  width: 100%;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.ctb-sheet__item,
.ctb-sheet__cancel {
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  background: #ffffff;
  color: #1f2937;
  font-size: 32rpx;
}

.ctb-sheet__item:first-child {
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
}

.ctb-sheet__item + .ctb-sheet__item {
  border-top: 1rpx solid #edf0f4;
}

.ctb-sheet__item:nth-child(2) {
  border-bottom-left-radius: 20rpx;
  border-bottom-right-radius: 20rpx;
}

.ctb-sheet__gap {
  height: 16rpx;
}

.ctb-sheet__cancel {
  border-radius: 20rpx;
  font-weight: 600;
}
